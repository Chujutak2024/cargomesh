# MCP transport mode. Local remains opt-in, loopback-only and limited to
# development/test. Remote requires its own opt-in plus exact HTTPS origins.
CARGOMESH_MCP_MODE=local
CARGOMESH_MCP_LOCAL_ENABLED=false
CARGOMESH_MCP_REMOTE_ENABLED=false
# V2 is the fail-safe default. Enable V1_REGRESSION explicitly only for
# historical tests and demos.
CARGOMESH_MCP_PROFILE=V2
# Remote-only server configuration. Values must be HTTPS origins without a
# path, query, fragment, credentials or wildcard. Include the canonical origin
# in the comma-separated allowlist. Authentication is still required.
# CARGOMESH_MCP_CANONICAL_ORIGIN=https://replace-with-public-mcp-host.example
# CARGOMESH_MCP_ALLOWED_ORIGINS=https://replace-with-public-mcp-host.example

# Tier 1 MCP service authentication. Keep both secrets server-only, different,
# random and at least 32 bytes. Issuer and resource use the same HTTPS origin.
# CARGOMESH_OAUTH_ISSUER=https://replace-with-public-mcp-host.example
# CARGOMESH_MCP_CANONICAL_RESOURCE=https://replace-with-public-mcp-host.example/mcp
# CARGOMESH_MCP_SERVICE_CLIENT_ID=replace-with-static-service-client-id
# CARGOMESH_MCP_SERVICE_CLIENT_SECRET=replace-with-at-least-32-random-bytes
# CARGOMESH_MCP_JWT_SIGNING_SECRET=replace-with-a-different-32-byte-signing-secret
# CARGOMESH_MCP_TOKEN_TTL_SECONDS=900

# Supabase OAuth user bearer boundary. It remains disabled until HAC-21 provides
# persistent mcp_account_links and hosted issuer/client behavior is verified.
CARGOMESH_MCP_USER_BEARER_ENABLED=false
# CARGOMESH_MCP_USER_OAUTH_CLIENT_ID=replace-with-registered-oauth-client-id

# Optional narration adapter. Deterministic SSML remains the default fallback.
CARGOMESH_BEDROCK_NARRATION_ENABLED=false
# CARGOMESH_BEDROCK_REGION=us-east-1
# CARGOMESH_BEDROCK_MODEL_ID=replace-with-authorized-model-id

# Local development (port 56321 matches supabase/config.toml).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:56321
NEXT_PUBLIC_CARGOMESH_TOOL_CALLER_ORIGINS=http://localhost:3000,http://localhost:3001
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-legacy-anon-key

# Server-only credential. Never prefix it with NEXT_PUBLIC_ or commit its value.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Server-only credentials for the one-click technical demo login. Never expose
# these through NEXT_PUBLIC_* or reuse the local seed password in production.
CARGOMESH_DEMO_LOGIN_EMAIL=replace-with-hosted-demo-user
CARGOMESH_DEMO_LOGIN_PASSWORD=replace-with-hosted-demo-password

# Local Autonomous Provider Execution V1. The worker accepts only loopback
# origins and obtains all freight/provider inputs from the persisted run.
CARGOMESH_WEBMCP_WORKER_BASE_URL=http://127.0.0.1:3000
# CARGOMESH_WEBMCP_CHROME=C:\Program Files\Google\Chrome\Application\chrome.exe
# CARGOMESH_WEBMCP_DEBUG_PORT=9334
# CARGOMESH_WEBMCP_WORKER_TIMEOUT_MS=180000

# Release-only input for npm run release:preflight and npm run release:smoke.
# This is not consumed by the Next.js application.
CARGOMESH_RELEASE_URL=https://replace-with-public-cargomesh-domain.example

# Production values must use HTTPS and the exact CargoMesh origin, without a
# wildcard, path, query, fragment, or credentials:
# NEXT_PUBLIC_SUPABASE_URL=https://replace-with-project-ref.supabase.co
# NEXT_PUBLIC_CARGOMESH_TOOL_CALLER_ORIGINS=https://replace-with-public-cargomesh-domain.example
