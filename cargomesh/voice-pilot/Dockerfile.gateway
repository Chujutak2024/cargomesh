FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AWS_REGION=us-east-1

WORKDIR /app
COPY requirements-gateway.txt ./
RUN pip install --no-cache-dir -r requirements-gateway.txt \
    && useradd --system --uid 10001 --home /nonexistent cmvoice

COPY nova_voice_gateway.py strands_gemini_live.py ./
USER cmvoice
EXPOSE 8765
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8765/healthz', timeout=2)" || exit 1

ENTRYPOINT ["python", "nova_voice_gateway.py"]
CMD ["--deploy", "--host", "0.0.0.0", "--port", "8765"]
