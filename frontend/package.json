{
  "name": "cargomesh-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test:auth": "tsx --test src/features/auth/password-login.test.ts src/features/auth/route-access-policy.test.ts src/features/auth/login-copy.test.ts",
    "test:discovery": "tsx --test src/features/discovery/candidate-matcher.test.ts",
    "test:c02": "tsx --test src/features/decision-engine/balanced.test.ts src/features/result-bridge/validation.test.ts",
    "test:int02a": "tsx --test src/features/orchestration/start-run-input.test.ts src/features/orchestration/view-model.test.ts",
    "test:int02a-runner": "tsx --test src/features/webmcp-runner/provider-runner.test.ts src/features/webmcp-runner/orchestration-runner.test.ts",
    "test:external-navigation": "tsx --test src/features/webmcp-runner/external-provider-navigation-adapter.test.ts",
    "test:freight-intent": "tsx --test src/features/freight-requests/execution-intent.test.ts",
    "test:freight-intake": "tsx --test src/features/freight-requests/intake.test.ts src/features/freight-requests/intake-ui-adapter.test.ts src/features/freight-ui/int02a-client.test.ts",
    "test:dashboard": "tsx --test src/features/dashboard/dashboard-view-model.test.ts",
    "test:a04": "tsx --test src/features/providers/provider-query-tools.test.ts src/features/providers/provider-booking-tools.test.ts",
    "test:booking": "tsx --test src/features/booking/validation.test.ts src/features/booking/server-policy.test.ts src/features/booking/bridge-call-id.test.ts",
    "test:d1-recommendations": "tsx --test src/features/recommendations/recommendation-webmcp-runtime.test.ts",
    "test:release": "npm run test:discovery && npm run test:c02 && npm run test:int02a && npm run test:int02a-runner && npm run test:external-navigation && npm run test:freight-intent && npm run test:freight-intake && npm run test:dashboard && npm run test:a04 && npm run test:booking && npm run test:d1-recommendations",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:verify": "npm run typecheck && npm run test:release && npm run build && npm run release:preflight"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.1.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.0.1",
    "webmcp-types": "^0.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3"
  }
}
