<mxfile host="app.diagrams.net" agent="Codex" type="device">
  <diagram id="request-state" name="1 - Solicitud actual y objetivo">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1000"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="r-title" value="&lt;b&gt;FreightRequest · estados V2&lt;/b&gt;&lt;br&gt;Verde = transición DRAFT→PENDING comprobada en código; amarillo = propuesta posterior, NO workflow implementado. Errores de concurrencia no son estados de negocio." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=17;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1700" height="90" as="geometry"/></mxCell>
      <mxCell id="r-draft" value="&lt;b&gt;DRAFT&lt;/b&gt;&lt;br&gt;edición con draftVersion" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=16;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="220" height="110" as="geometry"/></mxCell>
      <mxCell id="r-pending" value="&lt;b&gt;PENDING&lt;/b&gt;&lt;br&gt;solicitud enviada" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=16;" vertex="1" parent="1"><mxGeometry x="470" y="300" width="220" height="110" as="geometry"/></mxCell>
      <mxCell id="r-discover" value="&lt;b&gt;DISCOVERY_RUNNING&lt;/b&gt;&lt;br&gt;estado conceptual; nombre por acordar" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="850" y="290" width="270" height="130" as="geometry"/></mxCell>
      <mxCell id="r-options" value="&lt;b&gt;OPTIONS_READY&lt;/b&gt;&lt;br&gt;candidatos ≠ ofertas" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1360" y="210" width="270" height="125" as="geometry"/></mxCell>
      <mxCell id="r-none" value="&lt;b&gt;NO_CANDIDATES&lt;/b&gt;&lt;br&gt;motivos + unknown visibles" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1360" y="450" width="270" height="125" as="geometry"/></mxCell>
      <mxCell id="r-note" value="&lt;b&gt;No copiar la FSM de V1:&lt;/b&gt; el CHECK SQL remoto permite PENDING, ORCHESTRATING, AWAITING_SELECTION, BOOKING, BOOKED, FAILED y CANCELLED; eso no acredita transiciones de negocio V2. Idempotent replay devuelve el mismo resultado. STALE_DRAFT = 409 sin mutación. CANCELLED y pasos posteriores requieren definición de guards/eventos/owner." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=15;align=left;spacing=15;" vertex="1" parent="1"><mxGeometry x="90" y="680" width="1540" height="170" as="geometry"/></mxCell>
      <mxCell id="r-e1" value="submit; tenant, payload, versión e idempotencia válidos" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2e7d32;fontSize=14;" edge="1" parent="1" source="r-draft" target="r-pending"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="r-e2" value="iniciar discovery V2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#f9a825;fontSize=14;" edge="1" parent="1" source="r-pending" target="r-discover"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="r-e3" value="1..N candidatos verificables" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#f9a825;fontSize=14;" edge="1" parent="1" source="r-discover" target="r-options"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="r-e4" value="0 elegibles; razón trazada" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;strokeColor=#f9a825;fontSize=14;" edge="1" parent="1" source="r-discover" target="r-none"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="market-state" name="2 - Oportunidad y oferta">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1050"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="0-title" value="&lt;b&gt;CarrierOpportunity y CarrierOffer · ciclos separados, ambos propuestos&lt;/b&gt;&lt;br&gt;Ninguno está implementado como contrato V2. La oportunidad invita; solo el carrier/adaptador autorizado origina oferta real." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=17;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1700" height="90" as="geometry"/></mxCell>
      <mxCell id="o-invite" value="INVITED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="100" y="220" width="215" height="100" as="geometry"/></mxCell>
      <mxCell id="o-wait" value="AWAITING_RESPONSE" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="220" width="250" height="100" as="geometry"/></mxCell>
      <mxCell id="o-offered" value="RESPONDED_WITH_OFFER" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="990" y="165" width="300" height="110" as="geometry"/></mxCell>
      <mxCell id="o-decline" value="DECLINED / EXPIRED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="990" y="330" width="300" height="110" as="geometry"/></mxCell>
      <mxCell id="f-sub" value="OFFER SUBMITTED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="110" y="650" width="240" height="100" as="geometry"/></mxCell>
      <mxCell id="f-valid" value="VALID / COMPARABLE" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="560" y="650" width="260" height="100" as="geometry"/></mxCell>
      <mxCell id="f-select" value="SELECTED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1100" y="570" width="220" height="100" as="geometry"/></mxCell>
      <mxCell id="f-exp" value="EXPIRED / WITHDRAWN" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1100" y="750" width="270" height="100" as="geometry"/></mxCell>
      <mxCell id="m-note" value="&lt;b&gt;Guards por definir:&lt;/b&gt; ventana de respuesta, autenticidad del carrier, precio/moneda/desglose, vigencia, cobertura/capacidad revalidada, selección autorizada. Estados son propuesta conceptual: nombres SQL, revocación y transiciones requieren issue y pruebas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=14;align=left;spacing=13;" vertex="1" parent="1"><mxGeometry x="110" y="900" width="1520" height="90" as="geometry"/></mxCell>
      <mxCell id="o-e1" value="entrega invitación" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="o-invite" target="o-wait"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="o-e2" value="respuesta válida" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="o-wait" target="o-offered"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="o-e3" value="rechazo o vence plazo" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="o-wait" target="o-decline"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="f-e1" value="validar fuente y términos" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="f-sub" target="f-valid"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="f-e2" value="shipper autoriza" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="f-valid" target="f-select"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="f-e3" value="fuera de vigencia / retira carrier" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="f-valid" target="f-exp"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="booking-link-state" name="3 - Booking y cuenta MCP">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1000"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="x-title" value="&lt;b&gt;Booking V2 y vínculo MCP · propuesta, no implementación live&lt;/b&gt;&lt;br&gt;La tabla bookings y booking_authorizations de V1 existen, pero no se asumen conformes a V2. mcp_account_links todavía no existe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=17;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1700" height="90" as="geometry"/></mxCell>
      <mxCell id="k-authorize" value="AUTHORIZED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="100" y="240" width="210" height="100" as="geometry"/></mxCell>
      <mxCell id="k-request" value="REQUESTED_TO_CARRIER" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="510" y="240" width="270" height="100" as="geometry"/></mxCell>
      <mxCell id="k-confirm" value="CONFIRMED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1090" y="170" width="230" height="100" as="geometry"/></mxCell>
      <mxCell id="k-reject" value="REJECTED / EXPIRED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1090" y="335" width="270" height="100" as="geometry"/></mxCell>
      <mxCell id="l-none" value="UNLINKED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="120" y="660" width="215" height="100" as="geometry"/></mxCell>
      <mxCell id="l-active" value="ACTIVE" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="590" y="660" width="215" height="100" as="geometry"/></mxCell>
      <mxCell id="l-revoked" value="REVOKED" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1110" y="660" width="215" height="100" as="geometry"/></mxCell>
      <mxCell id="x-note" value="&lt;b&gt;Gate:&lt;/b&gt; sin link activo, scope y membresía vigentes → FORBIDDEN (fail closed). Booking requiere autorización humana auditada o política V2 expresamente aprobada; nunca se ejecuta por scoring solo. Confirmación y estado del carrier requieren integración/evidencia reales." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=14;align=left;spacing=13;" vertex="1" parent="1"><mxGeometry x="110" y="840" width="1500" height="100" as="geometry"/></mxCell>
      <mxCell id="k-e1" value="idempotency key + oferta vigente" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="k-authorize" target="k-request"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="k-e2" value="carrier confirma" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="k-request" target="k-confirm"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="k-e3" value="rechazo o timeout" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="k-request" target="k-reject"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="l-e1" value="consentimiento + organización + scopes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="l-none" target="l-active"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="l-e2" value="revocación explícita" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="l-active" target="l-revoked"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
  <diagram id="capacity-state" name="4 - Capacidad por ventana">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="950"><root>
      <mxCell id="0"/><mxCell id="1" parent="0"/>
      <mxCell id="c-title" value="&lt;b&gt;Capacidad ROAD por recurso y ventana · hipótesis para HAC-12&lt;/b&gt;&lt;br&gt;Todos los estados son propuestos. No hay calendario/reserva V2 en Git ni en Supabase remoto. Validar si se modela por activo individual, pool contratado o ambos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=17;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1700" height="90" as="geometry"/></mxCell>
      <mxCell id="c-available" value="AVAILABLE&lt;br&gt;capacidad comprobada" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="90" y="300" width="240" height="115" as="geometry"/></mxCell>
      <mxCell id="c-held" value="HELD&lt;br&gt;bloqueo temporal" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="510" y="300" width="230" height="115" as="geometry"/></mxCell>
      <mxCell id="c-reserved" value="RESERVED&lt;br&gt;booking confirmado" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="960" y="300" width="250" height="115" as="geometry"/></mxCell>
      <mxCell id="c-blocked" value="UNAVAILABLE&lt;br&gt;mantenimiento / viaje / reposición" style="ellipse;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1440" y="290" width="275" height="135" as="geometry"/></mxCell>
      <mxCell id="c-unknown" value="UNKNOWN&lt;br&gt;dato insuficiente; no confirmar" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=15;" vertex="1" parent="1"><mxGeometry x="800" y="600" width="280" height="120" as="geometry"/></mxCell>
      <mxCell id="c-note" value="&lt;b&gt;Guardias por acordar:&lt;/b&gt; ventanas solapadas, reserva atómica, capacidad restante, recurso auxiliar vs portador, dos unidades disponibles simultáneamente, expiración de hold, cancelación y reposicionamiento. UNKNOWN es resultado de evaluación cuando faltan datos, no una reserva persistida por defecto." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=14;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="90" y="790" width="1620" height="100" as="geometry"/></mxCell>
      <mxCell id="c-e1" value="hold atómico + TTL" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="c-available" target="c-held"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="c-e2" value="confirmación de booking" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="c-held" target="c-reserved"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="c-e3" value="expira / cancela; revalidar" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="c-held" target="c-available"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="c-e4" value="ocupa ventana y reposiciona" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="c-reserved" target="c-blocked"><mxGeometry relative="1" as="geometry"/></mxCell>
      <mxCell id="c-e5" value="ventana liberada y validada" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="c-blocked" target="c-available"><mxGeometry relative="1" as="geometry"/></mxCell>
    </root></mxGraphModel>
  </diagram>
</mxfile>
