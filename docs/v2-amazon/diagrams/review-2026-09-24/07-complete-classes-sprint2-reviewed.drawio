        <mxCell id="cm-v2fix-14" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=24;fontColor=#172b41;strokeColor=none;fillColor=none;" value="&lt;b&gt;Reglas del dominio, alcance por clase y estados&lt;/b&gt;" vertex="1">
          <mxGeometry height="50" width="5000" x="90" y="3030" as="geometry" />
        </mxCell>
        <mxCell id="cm-v2fix-15" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=22;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontFamily=Arial;fontSize=15;fontColor=#172b41;fillColor=#eef4fb;strokeColor=#5b7aa0;" value="&lt;b&gt;Alcance por clase&lt;/b&gt;&lt;br&gt;&lt;br&gt;«existente» — concepto con soporte físico previo (tabla, columnas o JSONB); no implica tabla propia ni semántica V2 completa.&lt;br&gt;«HITO 2» — Sprint 2: contrato ROAD/API/MCP; TransportPlanCandidate es resultado preliminar, no oferta ni reserva. La persistencia de cada clase se decide en HAC-27/12.&lt;br&gt;«HITO 3–4» — Sprints 3–4: plan comercial por tramo, oferta emitida por el carrier, ranking, selección y booking humano.&lt;br&gt;«roadmap» — diseño no operativo: multimodal live, consolidación, conductores, ejecución, incidentes y simulación productiva.&lt;br&gt;«· tabla V1» — existe tabla heredada; reutilizarla exige revisión de semántica, RLS y migración aditiva.&lt;br&gt;&lt;br&gt;&lt;i&gt;Clasificación de diseño; no es DER ni autoriza crear 57 tablas.&lt;/i&gt;" vertex="1">
          <mxGeometry height="380" width="1100" x="90" y="3100" as="geometry" />
        </mxCell>
        <mxCell id="cm-v2fix-16" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=22;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontFamily=Arial;fontSize=15;fontColor=#172b41;fillColor=#fff9db;strokeColor=#b59f3b;" value="&lt;b&gt;Invariante · Disponibilidad&lt;/b&gt;&lt;br&gt;&lt;br&gt;{sin agenda verificable ⇒ disponibilidad = UNKNOWN}&lt;br&gt;{nunca «disponible» por defecto}&lt;br&gt;&lt;br&gt;Aplica a CapacitySource, CapacityCalendar y TransportPlanCandidate." vertex="1">
          <mxGeometry height="380" width="1300" x="1250" y="3100" as="geometry" />
        </mxCell>
        <mxCell id="cm-v2fix-17" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=22;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontFamily=Arial;fontSize=15;fontColor=#172b41;fillColor=#fff9db;strokeColor=#b59f3b;" value="&lt;b&gt;Invariante · Cobertura&lt;/b&gt;&lt;br&gt;&lt;br&gt;{ServiceArea: EXCLUDE prevalece sobre INCLUDE}&lt;br&gt;{ServiceLane es dirigida: A→B no implica B→A}&lt;br&gt;{cobertura ≠ disponibilidad ≠ oferta}" vertex="1">
          <mxGeometry height="380" width="1300" x="2610" y="3100" as="geometry" />
        </mxCell>
        <mxCell id="cm-v2fix-18" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=22;align=left;verticalAlign=top;spacingLeft=14;spacingTop=10;spacingRight=10;fontFamily=Arial;fontSize=15;fontColor=#172b41;fillColor=#fff9db;strokeColor=#b59f3b;" value="&lt;b&gt;Invariante · Oferta&lt;/b&gt;&lt;br&gt;&lt;br&gt;{CarrierOffer.carrier = CarrierOpportunity.carrier invitado}&lt;br&gt;{tramos y servicios cubiertos ⊆ PlanLegAssignment del plan propuesto}&lt;br&gt;{la oferta la emite el Carrier; CargoMesh no crea ofertas}" vertex="1">
          <mxGeometry height="380" width="1300" x="3970" y="3100" as="geometry" />
        </mxCell>
