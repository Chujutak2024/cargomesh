        <mxCell id="cm-v2fix-13" connectable="0" parent="cm-v2fix-11" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontFamily=Arial;fontSize=14;fontStyle=1;labelBackgroundColor=#ffffff;" value="0..*" vertex="1">
