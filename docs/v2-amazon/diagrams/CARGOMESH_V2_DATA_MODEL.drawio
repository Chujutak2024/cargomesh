  <diagram id="implemented-hac21" name="1 - Git HAC-21 (no remoto)">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="i-title" value="&lt;b&gt;CargoMesh V2 · ERD físico integrado en Git, no desplegado en Supabase remoto&lt;/b&gt;&lt;br&gt;Fuente: migración HAC-21 20260922053512_v2_road_facilities_services.sql. El remoto sigue en 20260902213000; no representa capacidad ni ofertas V2." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=17;fontColor=#0d47a1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1980" height="90" as="geometry"/></mxCell>
        <mxCell id="i-legend" value="&lt;b&gt;Verde:&lt;/b&gt; tabla nueva HAC-21 &amp;nbsp;&amp;nbsp; &lt;b&gt;Gris:&lt;/b&gt; tabla existente (origen legacy) &amp;nbsp;&amp;nbsp; &lt;b&gt;Líneas:&lt;/b&gt; FK real &amp;nbsp;&amp;nbsp; RLS en nuevas tablas; sede ≠ cobertura." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=12;fillColor=#fafafa;strokeColor=#757575;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="135" width="1980" height="55" as="geometry"/></mxCell>
        <mxCell id="i-org" value="&lt;b&gt;organizations&lt;/b&gt; · existente&lt;br&gt;PK id&lt;br&gt;tenant shipper" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="280" width="270" height="125" as="geometry"/></mxCell>
        <mxCell id="i-member" value="&lt;b&gt;organization_members&lt;/b&gt; · existente&lt;br&gt;PK id · FK organization_id&lt;br&gt;rol/estado para RLS" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="485" width="270" height="145" as="geometry"/></mxCell>
        <mxCell id="i-fac" value="&lt;b&gt;facilities&lt;/b&gt; · HAC-21&lt;br&gt;PK id · FK organization_id&lt;br&gt;UQ (organization_id, code)&lt;br&gt;ubicación / RLS tenant" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="490" y="270" width="310" height="170" as="geometry"/></mxCell>
        <mxCell id="i-request" value="&lt;b&gt;freight_requests&lt;/b&gt; · existente + FK HAC-21&lt;br&gt;PK id · FK organization_id&lt;br&gt;origin_facility_id? / destination_facility_id?&lt;br&gt;FK compuesta por organización; DRAFT→PENDING preservado" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="270" width="400" height="190" as="geometry"/></mxCell>
        <mxCell id="i-carrier" value="&lt;b&gt;carriers&lt;/b&gt; · existente&lt;br&gt;PK id&lt;br&gt;0..N servicios / depots" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="790" width="270" height="125" as="geometry"/></mxCell>
        <mxCell id="i-depot" value="&lt;b&gt;carrier_depots&lt;/b&gt; · HAC-21&lt;br&gt;PK id · FK carrier_id&lt;br&gt;UQ (carrier_id, code)&lt;br&gt;depósito ≠ cobertura" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="490" y="710" width="310" height="160" as="geometry"/></mxCell>
        <mxCell id="i-service" value="&lt;b&gt;carrier_services&lt;/b&gt; · existente&lt;br&gt;PK id · FK carrier_id&lt;br&gt;transport_mode; campos geográficos V1&lt;br&gt;los campos V1 NO prueban cobertura V2" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="950" y="710" width="360" height="165" as="geometry"/></mxCell>
        <mxCell id="i-area" value="&lt;b&gt;service_areas&lt;/b&gt; · HAC-21&lt;br&gt;PK id · FK carrier_service_id&lt;br&gt;PICKUP / DELIVERY · INCLUDE / EXCLUDE&lt;br&gt;granularidad, fuente, evidencia, vigencia" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1450" y="655" width="350" height="175" as="geometry"/></mxCell>
        <mxCell id="i-lane" value="&lt;b&gt;service_lanes&lt;/b&gt; · HAC-21&lt;br&gt;PK id · FK carrier_service_id&lt;br&gt;FK (pickup_area_id, service_id)&lt;br&gt;FK (delivery_area_id, service_id)&lt;br&gt;ROAD; A→B no implica B→A" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#e8f5e9;strokeColor=#2e7d32;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1450" y="920" width="350" height="185" as="geometry"/></mxCell>
        <mxCell id="i-note" value="&lt;b&gt;Límite de este ERD:&lt;/b&gt; no contiene mcp_account_links, agenda de capacidad, reservas, ruta multimodal, ranking ni oferta V2. Son diseño/implementación posterior. Las tablas legacy vehicles/carrier_offers/bookings existen, pero no prueban sus contratos V2." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="1010" width="1200" height="115" as="geometry"/></mxCell>
        <mxCell id="i-e1" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=13;" edge="1" parent="1" source="i-org" target="i-member"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e2" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;fontSize=13;" edge="1" parent="1" source="i-org" target="i-fac"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e3" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=13;" edge="1" parent="1" source="i-org" target="i-request"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e4" value="origen 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;fontSize=13;" edge="1" parent="1" source="i-fac" target="i-request"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e5" value="destino 0..1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;fontSize=13;exitY=0.8;entryY=0.8;" edge="1" parent="1" source="i-fac" target="i-request"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e6" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;fontSize=13;" edge="1" parent="1" source="i-carrier" target="i-depot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e7" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#546e7a;fontSize=13;" edge="1" parent="1" source="i-carrier" target="i-service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e8" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;fontSize=13;" edge="1" parent="1" source="i-service" target="i-area"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e9" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;fontSize=13;" edge="1" parent="1" source="i-service" target="i-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="i-e10" value="PICKUP + DELIVERY" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#2e7d32;fontSize=13;" edge="1" parent="1" source="i-area" target="i-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
