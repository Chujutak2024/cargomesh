  </diagram>
  <diagram id="sprint2-proposed" name="2 - Decisiones Sprint 2">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1250" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="s-title" value="&lt;b&gt;CargoMesh V2 · decisiones de datos para Sprint 2&lt;/b&gt;&lt;br&gt;Diseño lógico para revisión del jueves. Amarillo = propuesto, NO tabla SQL aprobada. Verde/gris = base existente." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=17;fontColor=#0d47a1;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1980" height="90" as="geometry"/></mxCell>
        <mxCell id="s-org" value="&lt;b&gt;organizations&lt;/b&gt;&lt;br&gt;tenant shipper · existente" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="280" height="105" as="geometry"/></mxCell>
        <mxCell id="s-member" value="&lt;b&gt;organization_members&lt;/b&gt;&lt;br&gt;usuario / rol / estado · existente" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="280" height="115" as="geometry"/></mxCell>
        <mxCell id="s-link" value="&lt;b&gt;mcp_account_links&lt;/b&gt; · HAC-11&lt;br&gt;auth_user_id + oauth_client_id + organization_id&lt;br&gt;ACTIVE / REVOKED; scopes; RLS&lt;br&gt;No elegir primera membresía" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="490" y="310" width="390" height="165" as="geometry"/></mxCell>
        <mxCell id="s-request" value="&lt;b&gt;freight_requests&lt;/b&gt;&lt;br&gt;solicitud / organización / ventana&lt;br&gt;existente, extensión V2 pendiente" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="775" width="280" height="140" as="geometry"/></mxCell>
        <mxCell id="s-service" value="&lt;b&gt;carrier_services&lt;/b&gt;&lt;br&gt;servicio / modo · existente&lt;br&gt;áreas + lanes HAC-21 solo en Git" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="490" y="735" width="360" height="145" as="geometry"/></mxCell>
        <mxCell id="s-asset" value="&lt;b&gt;TransportAsset / CapacityPool&lt;/b&gt; · concepto&lt;br&gt;unidad física O cupo contratado&lt;br&gt;capacidad útil / equipo / fuente&lt;br&gt;no confundir con vehicles legacy" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1000" y="570" width="360" height="170" as="geometry"/></mxCell>
        <mxCell id="s-calendar" value="&lt;b&gt;CapacityCalendar + reservas&lt;/b&gt; · concepto HAC-12&lt;br&gt;ventana, mantenimiento, viaje y reposición&lt;br&gt;capacidad restante por recurso/tramo&lt;br&gt;tabla/clave exacta: decisión pendiente" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1510" y="570" width="390" height="170" as="geometry"/></mxCell>
        <mxCell id="s-eligibility" value="&lt;b&gt;Resultado de elegibilidad&lt;/b&gt; · servicio, NO tabla&lt;br&gt;eligible / ineligible / unknown&lt;br&gt;motivos + fuente + fecha + ventana&lt;br&gt;Web y MCP consumen la misma decisión" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#e3f2fd;strokeColor=#1565c0;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1000" y="870" width="500" height="170" as="geometry"/></mxCell>
        <mxCell id="s-note" value="&lt;b&gt;Preguntas del jueves:&lt;/b&gt; 1) ¿identidad/consentimiento de account link? 2) ¿activo individual o pool por servicio? 3) ¿reserva/concurrencia y reposicionamiento? 4) ¿qué es desconocido vs no elegible? 5) ¿qué se entrega de verdad en Sprint 2?" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="80" y="1060" width="1820" height="95" as="geometry"/></mxCell>
        <mxCell id="s-e1" value="tenant" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#607d8b;" edge="1" parent="1" source="s-org" target="s-member"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-e2" value="validar membresía activa (FK pendiente)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="s-member" target="s-link"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-e3" value="organización autorizada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="s-org" target="s-link"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-e4" value="1:N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#607d8b;" edge="1" parent="1" source="s-org" target="s-request"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-e5" value="cupo/equipo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="s-service" target="s-asset"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-e6" value="agenda" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="s-asset" target="s-calendar"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-e7" value="evalúa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;" edge="1" parent="1" source="s-request" target="s-eligibility"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-e8" value="áreas + lane + restricciones" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#1565c0;" edge="1" parent="1" source="s-service" target="s-eligibility"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="s-e9" value="ventana disponible / unknown" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="s-calendar" target="s-eligibility"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="future-domain" name="3 - Dominio objetivo posterior">
    <mxGraphModel dx="1600" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2200" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="f-title" value="&lt;b&gt;CargoMesh V2 · modelo conceptual posterior a Sprint 2&lt;/b&gt;&lt;br&gt;NO es un ERD de tablas desplegadas. Los nombres son conceptos de dominio y requieren diseño/migración/DoD propios." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=16;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1970" height="90" as="geometry"/></mxCell>
        <mxCell id="f-request" value="&lt;b&gt;FreightRequest&lt;/b&gt;&lt;br&gt;necesidad / carga / ventana / tenant&lt;br&gt;draft_version + idempotencia" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#eceff1;strokeColor=#607d8b;strokeWidth=2;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="230" width="310" height="145" as="geometry"/></mxCell>
        <mxCell id="f-route" value="&lt;b&gt;RoutePlan&lt;/b&gt; · objetivo&lt;br&gt;1..N tramos / modo / fuente&lt;br&gt;distancia y ETA estimadas, no SLA" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="520" y="230" width="310" height="145" as="geometry"/></mxCell>
        <mxCell id="f-plan" value="&lt;b&gt;TransportPlanCandidate&lt;/b&gt; · objetivo&lt;br&gt;carrier + servicio + ruta + recursos&lt;br&gt;fecha; restricciones; 0..N alternativas" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="970" y="230" width="340" height="165" as="geometry"/></mxCell>
        <mxCell id="f-opportunity" value="&lt;b&gt;CarrierOpportunity&lt;/b&gt; · objetivo&lt;br&gt;invitación por plan/servicio&lt;br&gt;no es oferta comercial" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1450" y="230" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="f-offer" value="&lt;b&gt;CarrierOffer V2&lt;/b&gt; · objetivo&lt;br&gt;emisor + precio + moneda + vigencia&lt;br&gt;desglose, fuente y condiciones&lt;br&gt;tabla carrier_offers legacy ≠ contrato V2" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1450" y="530" width="340" height="170" as="geometry"/></mxCell>
        <mxCell id="f-policy" value="&lt;b&gt;ScoringPolicy V2&lt;/b&gt; · objetivo&lt;br&gt;versión / pesos / desempate&lt;br&gt;compara solo ofertas conocidas&lt;br&gt;BALANCED V1 no es política universal" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="970" y="550" width="340" height="170" as="geometry"/></mxCell>
        <mxCell id="f-booking" value="&lt;b&gt;Booking autorizado V2&lt;/b&gt; · objetivo&lt;br&gt;selección humana + auditoría&lt;br&gt;confirmación del carrier / estado&lt;br&gt;tabla bookings legacy ≠ flujo V2" style="rounded=1;whiteSpace=wrap;html=1;spacing=12;fillColor=#fff8e1;strokeColor=#f9a825;strokeWidth=2;dashed=1;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1450" y="810" width="340" height="165" as="geometry"/></mxCell>
        <mxCell id="f-note" value="&lt;b&gt;Reglas de corte:&lt;/b&gt; filtros físicos/cobertura/capacidad antes de ranking; sin oferta no hay cotización; una escolta no aporta carga; costo/frontera/permisos pueden quedar unknown; un plan multimodal no es live por estar dibujado." style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=14;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=15;" vertex="1" parent="1"><mxGeometry x="70" y="820" width="1120" height="140" as="geometry"/></mxCell>
        <mxCell id="f-e1" value="resuelve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="f-request" target="f-route"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e2" value="genera candidatos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="f-route" target="f-plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e3" value="invita" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="f-plan" target="f-opportunity"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e4" value="carrier responde 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="f-opportunity" target="f-offer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e5" value="compara" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="f-policy" target="f-offer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="f-e6" value="selección + autorización" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#f9a825;dashed=1;" edge="1" parent="1" source="f-offer" target="f-booking"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
