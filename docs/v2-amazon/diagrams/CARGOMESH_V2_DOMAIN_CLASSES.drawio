<mxfile host="app.diagrams.net" agent="Codex" type="device">
  <diagram id="class-intake" name="1 - Solicitud y cobertura">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="1100">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="a-title" value="&lt;b&gt;CargoMesh V2 · clases de dominio: solicitud y cobertura&lt;/b&gt;&lt;br&gt;Gris = clase sobre tabla legacy; verde = HAC-21 integrado en Git, no remoto; azul = valor/servicio no persistido." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=17;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1770" height="80" as="geometry"/></mxCell>
        <mxCell id="a-org" value="&lt;b&gt;Organization&lt;/b&gt;&lt;br&gt;id · estado · tenant&lt;br&gt;1..N miembros; 0..N sedes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#607d8b;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="a-fac" value="&lt;b&gt;Facility&lt;/b&gt;&lt;br&gt;organizationId · ubicación&lt;br&gt;sede del shipper ≠ cobertura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="450" y="170" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="a-req" value="&lt;b&gt;FreightRequest&lt;/b&gt;&lt;br&gt;organizationId · draftVersion&lt;br&gt;origen/destino · ventana&lt;br&gt;estado DRAFT/PENDING validado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#607d8b;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="870" y="175" width="320" height="165" as="geometry"/></mxCell>
        <mxCell id="a-cargo" value="&lt;b&gt;CargoSpecification&lt;/b&gt; · value object&lt;br&gt;peso, volumen, unidades, dimensiones&lt;br&gt;fragilidad, temperatura, peligrosidad&lt;br&gt;actual: columnas + JSONB, no tabla separada" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1420" y="175" width="350" height="175" as="geometry"/></mxCell>
        <mxCell id="a-carrier" value="&lt;b&gt;Carrier&lt;/b&gt;&lt;br&gt;id · estado · integración declarada&lt;br&gt;0..N, sin lista fija" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#607d8b;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="585" width="270" height="140" as="geometry"/></mxCell>
        <mxCell id="a-depot" value="&lt;b&gt;CarrierDepot&lt;/b&gt;&lt;br&gt;carrierId · ubicación&lt;br&gt;no concede alcance geográfico" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="450" y="480" width="290" height="150" as="geometry"/></mxCell>
        <mxCell id="a-service" value="&lt;b&gt;CarrierService&lt;/b&gt;&lt;br&gt;carrierId · modo · tipo de servicio&lt;br&gt;ROAD hoy; otros modos requieren evidencia" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#607d8b;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="450" y="750" width="300" height="145" as="geometry"/></mxCell>
        <mxCell id="a-area" value="&lt;b&gt;ServiceArea&lt;/b&gt;&lt;br&gt;serviceId · PICKUP/DELIVERY&lt;br&gt;INCLUDE/EXCLUDE · fuente · vigencia&lt;br&gt;socio registrado puede aportar cobertura" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="900" y="595" width="340" height="170" as="geometry"/></mxCell>
        <mxCell id="a-lane" value="&lt;b&gt;ServiceLane&lt;/b&gt;&lt;br&gt;serviceId · pickupArea · deliveryArea&lt;br&gt;direccional A→B; no B→A implícita" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#2e7d32;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1430" y="595" width="340" height="145" as="geometry"/></mxCell>
        <mxCell id="a-elig" value="&lt;b&gt;EligibilityResult&lt;/b&gt; · value object&lt;br&gt;eligible / ineligible / unknown&lt;br&gt;motivos, evidencia, fecha, ventana&lt;br&gt;NO es estado de FreightRequest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1040" y="880" width="430" height="160" as="geometry"/></mxCell>
        <mxCell id="a-e1" value="1 a 0..N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="a-org" target="a-fac"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e2" value="1 a 0..N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="a-org" target="a-req"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e3" value="origen/destino opcionales, mismo tenant" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2e7d32;" edge="1" parent="1" source="a-fac" target="a-req"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e4" value="contiene 1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#1565c0;" edge="1" parent="1" source="a-req" target="a-cargo"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e5" value="1 a 0..N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="a-carrier" target="a-depot"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e6" value="1 a 0..N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;" edge="1" parent="1" source="a-carrier" target="a-service"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e7" value="1 a 0..N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2e7d32;" edge="1" parent="1" source="a-service" target="a-area"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e8" value="1 a 0..N" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2e7d32;" edge="1" parent="1" source="a-service" target="a-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e9" value="dos extremos del mismo servicio" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#2e7d32;" edge="1" parent="1" source="a-area" target="a-lane"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="a-e10" value="evalúa solicitud + servicio + ventana" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#1565c0;" edge="1" parent="1" source="a-service" target="a-elig"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="class-plan" name="2 - Plan y mercado V2">
    <mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1900" pageHeight="1100">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="b-title" value="&lt;b&gt;CargoMesh V2 · clases objetivo: capacidad, ruta, oferta y booking&lt;/b&gt;&lt;br&gt;Amarillo discontinuo = diseño pendiente; NO significa tabla creada ni integración live. Grises existentes conservan semántica V1 hasta migración V2." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e3f2fd;strokeColor=#1565c0;fontSize=17;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1770" height="80" as="geometry"/></mxCell>
        <mxCell id="b-asset" value="&lt;b&gt;TransportAsset / CapacityPool&lt;/b&gt;&lt;br&gt;activo o cupo contratado · capacidad útil&lt;br&gt;modo y equipo separados" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="190" width="350" height="160" as="geometry"/></mxCell>
        <mxCell id="b-cal" value="&lt;b&gt;CapacityCalendar&lt;/b&gt;&lt;br&gt;reservas, mantenimiento, reposición&lt;br&gt;disponibilidad por ventana y tramo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="325" height="155" as="geometry"/></mxCell>
        <mxCell id="b-route" value="&lt;b&gt;RoutePlan + RouteLeg&lt;/b&gt;&lt;br&gt;1..N tramos · modo · fuente&lt;br&gt;distancia/ETA; frontera, peajes, permisos&lt;br&gt;cotizado / estimado / unknown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="980" y="180" width="360" height="180" as="geometry"/></mxCell>
        <mxCell id="b-plan" value="&lt;b&gt;TransportPlanCandidate&lt;/b&gt;&lt;br&gt;carrier + servicio + ruta + fecha&lt;br&gt;1..N recursos compatibles y simultáneos&lt;br&gt;filtros duros antes del ranking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1450" y="180" width="350" height="180" as="geometry"/></mxCell>
        <mxCell id="b-opp" value="&lt;b&gt;CarrierOpportunity&lt;/b&gt;&lt;br&gt;invitación a carrier por plan&lt;br&gt;no es una cotización ni compromiso" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1450" y="535" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="b-offer" value="&lt;b&gt;CarrierOffer V2&lt;/b&gt;&lt;br&gt;emisor · precio · moneda · desglose&lt;br&gt;vigencia · fuente · condiciones&lt;br&gt;carrier_offers actual no prueba V2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1050" y="535" width="330" height="170" as="geometry"/></mxCell>
        <mxCell id="b-policy" value="&lt;b&gt;ScoringPolicy&lt;/b&gt;&lt;br&gt;versión · criterios · pesos · desempate&lt;br&gt;ranking reproducible de ofertas conocidas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="610" y="535" width="330" height="160" as="geometry"/></mxCell>
        <mxCell id="b-book" value="&lt;b&gt;Booking V2&lt;/b&gt;&lt;br&gt;selección y autorización auditable&lt;br&gt;confirmación del carrier; no auto-claim&lt;br&gt;bookings actual no prueba V2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="1050" y="825" width="350" height="165" as="geometry"/></mxCell>
        <mxCell id="b-link" value="&lt;b&gt;MCPAccountLink&lt;/b&gt; · HAC-11&lt;br&gt;usuario + cliente + organización + scopes&lt;br&gt;activo/revocado · RLS · fail closed&lt;br&gt;ausente hoy en Git y remoto" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#f9a825;dashed=1;fontSize=15;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="815" width="370" height="170" as="geometry"/></mxCell>
        <mxCell id="b-note" value="&lt;b&gt;Límites:&lt;/b&gt; no sumar escolta como capacidad; no heredar capacidad ni permiso histórico; no fabricar oferta; Web y Alexa comparten servicios de dominio. Selección de tablas/PK/FK exactas requiere issue + migración + RLS + pgTAP." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3e0;strokeColor=#ef6c00;fontSize=14;spacing=12;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="1020" width="1730" height="65" as="geometry"/></mxCell>
        <mxCell id="b-e1" value="descuenta" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="b-asset" target="b-cal"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e2" value="1 plan usa 1..N recursos" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="b-cal" target="b-plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e3" value="1 ruta; 1..N tramos" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="b-route" target="b-plan"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e4" value="0..N invitaciones" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="b-plan" target="b-opp"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e5" value="0..N respuestas" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="b-opp" target="b-offer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e6" value="evalúa" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="b-policy" target="b-offer"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="b-e7" value="selección autorizada" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;dashed=1;" edge="1" parent="1" source="b-offer" target="b-book"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
